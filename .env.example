# Local development settings. Copy to .env (git-ignored) and adjust:
#   cp .env.example .env
#   uv run --env-file .env uvicorn --factory app.main:app_from_env --no-proxy-headers --reload
# In Kubernetes these come from the Helm chart's values.yaml, not from this file.
# All variables are required: the app refuses to start if one is missing.
# Never put secrets here: this file is committed.

# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For header is trusted.
# Never "*". In kind this is the pod CIDR, where Traefik runs.
FORWARDED_ALLOW_IPS=127.0.0.1

# Serve /docs, /redoc and /openapi.json. "true" or "false".
DOCS_ENABLED=true
